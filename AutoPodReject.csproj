<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AutoPodReject</AssemblyName>
    <RootNamespace>AutoPodReject</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <OniManagedDir Condition="'$(OniManagedDir)' == '' and '$(ONI_MANAGED_DIR)' != ''">$(ONI_MANAGED_DIR)</OniManagedDir>
    <OniManagedDir Condition="'$(OniManagedDir)' == '' and '$(ONI_DIR)' != ''">$(ONI_DIR)/OxygenNotIncluded_Data/Managed</OniManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PLib" Version="4.22.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.40">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(OniManagedDir)' != ''">
    <Reference Include="0Harmony">
      <HintPath>$(OniManagedDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(OniManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(OniManagedDir)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(OniManagedDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(OniManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(OniManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RepackPLibIntoMod" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_PLibMergeAssemblies Include="$(OutputPath)PLib.dll" Condition="Exists('$(OutputPath)PLib.dll')" />
      <_ILRepackInputAssemblies Include="$(TargetPath)" />
      <_ILRepackInputAssemblies Include="@(_PLibMergeAssemblies)" />
    </ItemGroup>

    <Error Condition="'@(_PLibMergeAssemblies)' == ''" Text="PLib.dll was not found at $(OutputPath)PLib.dll; ensure the PLib NuGet package is restored and copied locally before bundling." />

    <Message Importance="high" Text="Bundling PLib into $(TargetPath): @(_PLibMergeAssemblies->'%(Filename)%(Extension)', ', ')" />
    <ILRepack
      InputAssemblies="@(_ILRepackInputAssemblies)"
      OutputFile="$(TargetDir)$(AssemblyName).repacked.dll"
      TargetKind="Dll"
      Internalize="false"
      DebugInfo="true"
      Parallel="true"
      LibraryPath="$(OutputPath);$(OniManagedDir)" />

    <Copy SourceFiles="$(TargetDir)$(AssemblyName).repacked.dll" DestinationFiles="$(TargetPath)" />
    <Delete Files="$(TargetDir)$(AssemblyName).repacked.dll" />
    <Delete Files="@(_PLibMergeAssemblies)" />
  </Target>
</Project>
